{
  "name": "serve-os",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000 --host",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "docker:dev:build": "docker compose --env-file .env.local build",
    "docker:dev": "docker compose --env-file .env.local up --build",
    "docker:dev:stop": "docker compose --env-file .env.local down",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml --env-file .env build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml --env-file .env up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml --env-file .env down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml --env-file .env logs -f",
    "test": "vitest run --passWithNoTests",
    "format": "biome format",
    "add:component": "npx shadcn@latest add",
    "lint": "biome lint",
    "check": "biome check",
    "check:fix": "biome check --write",
    "gen:api": "openapi-typescript http://localhost:4000/api/docs-json -o src/shared/api/generated/schema.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/roboto": "^5.2.10",
    "@hookform/resolvers": "^5.2.2",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "^1.168.18",
    "@tanstack/router-plugin": "^1.168.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-state-city": "^3.2.1",
    "ky": "^2.0.2",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "nitro": "^3.0.260311-beta",
    "pino": "^10.3.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^6.0.2",
    "react-hook-form": "^7.73.1",
    "shadcn": "^4.7.0",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@inlang/paraglide-js": "^2.13.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "openapi-typescript": "^7.8.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.2",
    "vite": "^7.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@11.2.2"
}
