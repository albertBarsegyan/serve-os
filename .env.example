# Serve-OS backend base URL (includes /api path).
#
# VITE_API_BASE_URL — baked into the client bundle at build time (browser-side fetches)
# API_BASE_URL      — read by the Nitro SSR server at runtime
#
# Local dev (no Docker):
#   VITE_API_BASE_URL=http://localhost:4000/api
#   API_BASE_URL=http://localhost:4000/api
#
# Docker dev (pnpm docker:dev — frontend + backend on serve_os_shared network):
#   VITE_API_BASE_URL=http://localhost:4000/api          # browser reaches backend via mapped port
#   API_BASE_URL=http://serve_os_app_dev:4000/api        # SSR reaches backend via Docker DNS
#
# Production (set via VITE_API_BASE_URL / API_BASE_URL secrets in CI):
#   VITE_API_BASE_URL=https://api.serve-os.net/api       # browser goes through Nginx
#   API_BASE_URL=http://serve_os_backend_prod:4000/api       # SSR reaches backend directly on shared network
VITE_API_BASE_URL=http://localhost:4000/api
API_BASE_URL=http://localhost:4000/api

# Container defaults (override as needed):
# HOST=0.0.0.0
# PORT=3000

# Optional: used by admin/staff UIs when there is no JWT with businessId (local dev)
# VITE_DEV_BUSINESS_ID=00000000-0000-0000-0000-000000000001
# VITE_DEV_DEFAULT_TABLE_ID=00000000-0000-0000-0000-000000000002

# Google Analytics 4 measurement ID. When set, gtag.js is injected in production builds only.
# Remove or leave blank to disable analytics (safe for local dev and staging).
VITE_GTAG_ID=G-304ZNMPV6R

# Public deployed origin (no trailing slash), used for robots.txt / sitemap.xml and
# for Open Graph / canonical / JSON-LD URLs.
#
# SITE_URL      — read by the Nitro SSR server at runtime (robots.txt, sitemap.xml).
#                 Falls back to the incoming request's origin when unset.
# VITE_SITE_URL — baked into the client bundle at build time (absolute OG/JSON-LD URLs).
#
# Production example:
#   SITE_URL=https://serve-os.net
#   VITE_SITE_URL=https://serve-os.net
SITE_URL=http://localhost:3000
VITE_SITE_URL=http://localhost:3000

# Web3Forms (landing page "start your journey" contact form).
# Access key is a public/client-side key by design (https://web3forms.com) — still
# kept out of source so it can be rotated per-environment without a code change.
VITE_WEB3FORMS_ACCESS_KEY=906bea0b-8bf0-4e7c-bd49-6382391215ba
VITE_WEB3FORMS_ENDPOINT=https://api.web3forms.com/submit
